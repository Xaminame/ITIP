public class Gruzchik extends Thread {
    private final Sklad sklad;

    public Gruzchik(String name, Sklad sklad) {
        super(name);
        this.sklad = sklad;
    }

    @Override
    public void run() {
        while (true) {
            Tovar t = sklad.takeTovar();
            if (t == null) break;  

            sklad.process(this, t);
            
            }
            try {
                Thread.sleep(200);
            } catch (InterruptedException e) {
                e.printStackTrace();
            }
        }
    }
